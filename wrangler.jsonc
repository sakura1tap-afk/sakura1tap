{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sakura1tap",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-16",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "REACTION_DB",
      "database_name": "sakura1tap-reaction"
    }
  ]
}
